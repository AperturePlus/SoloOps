{
  "name": "soloops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "dev:web": "bun run --cwd apps/web --bun dev",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "owner:init": "bun apps/api/src/owner-init.ts",
    "lint": "eslint .",
    "check": "tsc --noEmit --pretty false && bun run --cwd apps/web check",
    "test": "bun test",
    "build": "bun run check && bun run --cwd apps/web --bun build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/bun": "latest",
    "eslint": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prettier-plugin-svelte": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest"
  }
}
