SOLOOPS_ENV=development
SOLOOPS_HOST=127.0.0.1
SOLOOPS_API_PORT=3001
SOLOOPS_WEB_ORIGIN=http://127.0.0.1:5173
SOLOOPS_DATABASE_PATH=var/db/soloops.db
SOLOOPS_WEB_DIST=apps/web/build
SOLOOPS_SESSION_TTL_HOURS=24
SOLOOPS_EVENT_POLL_MS=500
SOLOOPS_WORKER_POLL_MS=1000
SOLOOPS_LOG=soloops=info,tower_http=info
SOLOOPS_LOG_FORMAT=json
SOLOOPS_METRICS_ENABLED=true
SOLOOPS_PUBLIC_IP_ENDPOINT=https://api.ipify.org
SOLOOPS_PUBLIC_IP_POLL_SECONDS=300
# Configure all SMTP fields below to enable Owner-managed public IPv4 notifications.
# SOLOOPS_SMTP_HOST=smtp.example.com
# SOLOOPS_SMTP_PORT=465
# SOLOOPS_SMTP_SECURITY=tls
# SOLOOPS_SMTP_FROM=SoloOps <soloops@example.com>
# SOLOOPS_SMTP_USERNAME=soloops@example.com
# SOLOOPS_SMTP_PASSWORD_REF=env:SOLOOPS_SMTP_PASSWORD
# Periodic Owner password rotation; requires SMTP. The API emails the freshly
# generated password to the designated mailbox, then activates it and revokes
# all sessions. Keep disabled if you prefer manual `soloopsctl owner-password-reset`.
# SOLOOPS_PASSWORD_ROTATION_ENABLED=false
# SOLOOPS_PASSWORD_ROTATION_INTERVAL_HOURS=168
# SOLOOPS_PASSWORD_ROTATION_EMAIL=owner@example.com
# Model API bootstrap. Values saved from the WebUI (Settings → Model API) take
# precedence over these variables; the worker re-reads them between runs, so
# WebUI edits apply without a restart. SOLOOPS_MODEL_NAME may stay empty when
# the settings are managed from the WebUI.
SOLOOPS_MODEL_BASE_URL=https://api.openai.com/v1
SOLOOPS_MODEL_NAME=
SOLOOPS_MODEL_API_KEY_REF=env:OPENAI_API_KEY
SOLOOPS_HOSTD_SOCKET=
SOLOOPS_HOSTD_ALLOWED_UID=
SOLOOPS_SANDBOX_ENABLED=false
SOLOOPS_DOCKER_SOCKET=/var/run/docker.sock
SOLOOPS_SANDBOX_IMAGE=
SOLOOPS_SANDBOX_PROGRAM_ALLOWLIST_JSON={}
SOLOOPS_SANDBOX_MEMORY_BYTES=536870912
SOLOOPS_SANDBOX_NANO_CPUS=1000000000
SOLOOPS_SANDBOX_PIDS_LIMIT=128
SOLOOPS_SANDBOX_TMPFS_BYTES=67108864
# Linux-only managed deployment; keep disabled until Docker Compose, Caddy, directories,
# site/port allowlists, and the Caddy import are configured.
SOLOOPS_MANAGED_DEPLOY_ENABLED=false
SOLOOPS_MANAGED_ROOT=/var/lib/soloops/deployments
SOLOOPS_DOCKER_CLI=/usr/bin/docker
SOLOOPS_CADDY_CLI=/usr/bin/caddy
SOLOOPS_CADDY_CONFIG=/etc/caddy/Caddyfile
SOLOOPS_CADDY_MANAGED_DIR=/etc/caddy/soloops.d
SOLOOPS_DEPLOY_SITE_ALLOWLIST_JSON=[]
SOLOOPS_DEPLOY_PORT_ALLOWLIST_JSON=[]
SOLOOPS_DEPLOY_HEALTH_ORIGIN=http://127.0.0.1
SOLOOPS_DEPLOY_HEALTH_TIMEOUT_MS=60000
SOLOOPS_DEPLOY_OPERATION_LEASE_MS=60000
SOLOOPS_DEPLOY_OPERATION_RENEW_MS=10000
SOLOOPS_DEPLOY_RECONCILE_INTERVAL_MS=15000
SOLOOPS_WORKSPACE_ROOT=var/workspaces
SOLOOPS_ARTIFACT_ROOT=var/artifacts
SOLOOPS_PROCESS_ALLOWLIST_JSON={}
SOLOOPS_WORKER_LEASE_MS=30000
SOLOOPS_WORKER_LEASE_RENEW_MS=10000
