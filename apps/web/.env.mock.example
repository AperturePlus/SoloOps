# Set to "1" to enable the in-process WebUI mock backend (apps/web/src/mock).
# Copy this file to `.env.mock` and run `bun run dev:mock` (which starts Vite
# in `--mode mock`, loading this file). When unset, `/api` is proxied to the
# real Rust backend at http://127.0.0.1:3001 as configured in vite.config.ts.
VITE_MOCK=1
